# Copy these values into the environment configuration of the private server.
# This file contains paths and defaults only. Do not put invitation codes or
# browser device tokens in environment variables or commit them to Git.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080

# DATABASE_PATH and BACKUP_ROOT must be absolute paths on persistent storage.
# Keep BACKUP_ROOT on separate storage if the host supports it.
DATABASE_PATH=/srv/riptop-arena/data/arena.sqlite
BACKUP_ROOT=/srv/riptop-arena-backups
SITE_ROOT=/srv/riptop-arena/app/dist/site

# Reserved for the image upload stage. It may be omitted until uploads exist.
UPLOAD_ROOT=/srv/riptop-arena/uploads

# Match timing defaults. Leave unchanged for the first friend-server release.
READY_TIMEOUT_MS=10000
TURN_TIMEOUT_MS=15000
HEARTBEAT_INTERVAL_MS=2000
HEARTBEAT_DEAD_MS=5000
