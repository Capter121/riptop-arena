{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-profile.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "color": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_id", "slots"],
      "properties": {
        "part_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "slots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/slot" }
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_index", "source_material_id", "surface_role", "archetype", "base_color", "metallic", "roughness", "double_sided"],
      "properties": {
        "slot_index": { "type": "integer", "minimum": 0 },
        "source_material_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "surface_role": { "enum": ["shell", "attack_edge", "accent", "transparent_insert", "contact_rubber", "connector_metal"] },
        "archetype": { "enum": ["painted_metal", "polished_metal", "engineering_plastic", "transparent_polycarbonate", "rubber", "energy_accent"] },
        "base_color": { "$ref": "#/$defs/color" },
        "metallic": { "type": "number", "minimum": 0, "maximum": 1 },
        "roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "double_sided": { "const": false },
        "transmission": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "ior": { "type": "number", "minimum": 1, "maximum": 2.5 },
        "thickness_mm": { "type": "number", "exclusiveMinimum": 0, "maximum": 20 },
        "emissive_color": { "$ref": "#/$defs/color" },
        "emissive_strength": { "type": "number", "exclusiveMinimum": 0, "maximum": 2 }
      },
      "allOf": [
        {
          "if": { "properties": { "archetype": { "const": "transparent_polycarbonate" } } },
          "then": { "required": ["transmission", "ior", "thickness_mm"] }
        },
        {
          "if": { "properties": { "archetype": { "const": "energy_accent" } } },
          "then": { "required": ["emissive_color", "emissive_strength"] }
        }
      ]
    }
  }
}
