{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nss-battle-loadout-v2.schema.json",
  "title": "NSS Battle Loadout V2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "interfaceId", "combination", "affinities"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "interfaceId": { "const": "NSS-V1" },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "blade", "assist", "gear", "tip"],
      "properties": {
        "core": { "type": "string", "pattern": "^core_[a-z0-9_]+$" },
        "blade": { "type": "string", "pattern": "^blade_[a-z0-9_]+$" },
        "assist": { "type": "string", "pattern": "^assist_[a-z0-9_]+$" },
        "gear": { "type": "string", "pattern": "^gear_[a-z0-9_]+$" },
        "tip": { "type": "string", "pattern": "^tip_[a-z0-9_]+$" }
      }
    },
    "affinities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core", "blade", "assist", "gear", "tip"],
      "properties": {
        "core": { "$ref": "#/$defs/affinity" },
        "blade": { "$ref": "#/$defs/affinity" },
        "assist": { "$ref": "#/$defs/affinity" },
        "gear": { "$ref": "#/$defs/affinity" },
        "tip": { "$ref": "#/$defs/affinity" }
      }
    }
  },
  "$defs": {
    "affinity": {
      "enum": ["WIND", "FIRE", "WATER", "WOOD", "EARTH", "LIGHT", "DARK"]
    }
  }
}
