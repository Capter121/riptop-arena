{
  "name": "riptop-arena",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 4176",
    "build": "node scripts/build-unified-site.mjs",
    "build:site": "node scripts/build-unified-site.mjs",
    "verify:site": "node scripts/verify-unified-site.mjs",
    "preview": "vite preview --outDir dist/site",
    "start": "node server/match-server.mjs",
    "server": "node server/match-server.mjs",
    "backup:server": "node scripts/backup-private-server.mjs",
    "restore:server": "node scripts/restore-private-server.mjs",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:server": "node scripts/test-match-server.mjs && node scripts/test-http-server.mjs && node scripts/test-database.mjs && node scripts/test-auth.mjs && node scripts/test-progression.mjs && npm run test:challenge-contract && npm run test:challenges && npm run test:challenge-http && npm run test:backup",
    "test:backup": "node scripts/test-private-server-archive.mjs",
    "test:http": "node scripts/test-http-server.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:progression": "node scripts/test-progression.mjs",
    "test:challenge-contract": "node scripts/test-challenge-contract.mjs",
    "test:challenges": "node scripts/test-challenges.mjs",
    "test:challenge-http": "node scripts/test-challenge-http.mjs",
    "test:nss-contract": "node scripts/test-nss-contract.mjs",
    "inspect:canvas": "node scripts/inspect-threejs-canvas.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "24.3.0",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "5.0.4",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "vite": "^7.1.7",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.3.0",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "^0.185.1",
    "ws": "^8.21.0",
    "zustand": "5.0.8"
  }
}
